<Window
    x:Class="NearLink.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NearLink.Windows"
    Title="NearLink">
    <Grid x:Name="Root" Padding="24" ColumnSpacing="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <InfoBar Grid.ColumnSpan="2" Margin="0,0,0,16" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                 Severity="Informational" Title="NearLink" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" Closed="Notice_Closed"/>
        <Grid Grid.Row="1" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="NearLink" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.LocalName}" TextWrapping="Wrap" Opacity="0.65"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <TextBlock Text="Devices" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Content="Refresh" Click="Refresh_Click"/>
            </Grid>
            <ListView x:Name="DeviceList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Devices}"
                      SelectionChanged="DeviceList_SelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceRow">
                        <StackPanel Padding="4,8" Spacing="3">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="3" Spacing="10">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
                <Button Content="Open received files" Click="OpenFolder_Click" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.ConversationStatus, Mode=OneWay}" Opacity="0.6"/>
            </StackPanel>
            <ListView x:Name="Timeline" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Conversation}" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ConversationRow">
                        <Border Margin="0,4" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Heading}" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <StackPanel Spacing="8" Visibility="{x:Bind TransferVisibility}">
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100"/>
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Open file" Visibility="{x:Bind OpenVisibility, Mode=OneWay}" Tag="{x:Bind}" Click="OpenFile_Click"/>
                                        <Button Content="Cancel" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" Tag="{x:Bind}" Click="Cancel_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Attach" IsEnabled="{x:Bind ViewModel.CanAttach, Mode=OneWay}" Click="Attach_Click"/>
                <TextBox x:Name="Composer" Grid.Column="1" PlaceholderText="Write a message" AcceptsReturn="True"
                         MaxHeight="140" TextWrapping="Wrap" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2" Content="Send" Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}" Click="Send_Click"/>
            </Grid>
            <TextBlock Grid.Row="3" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                       Text="Files up to 2 GiB are received automatically. Transfers are not encrypted; use a trusted local network."/>
        </Grid>
    </Grid>
</Window>
